{
  "name": "romania-construieste-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "vite --mode pages",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:server": "node --test test/static-server.test.cjs",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "serve-handler": "6.1.7",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
